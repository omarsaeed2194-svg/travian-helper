# Set these in Vercel → Project → Settings → Environment Variables.
# The password for the web app (not your Travian password). Use a long one.
APP_PASSWORD=
# Added automatically when you connect "Upstash for Redis" in Vercel → Storage:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# (or UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN)
# Optional: a fixed secret for signing logins (otherwise one is made and kept in the database).
# SESSION_SECRET=
